# -----------------------------------------------------------------------
# PartVault — Environment Configuration
# Copy this file to .env and fill in your values.
# -----------------------------------------------------------------------

# ── Discord ──────────────────────────────────────────────────────────────
# Required: Your Discord bot token (discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Comma-separated channel IDs where quick commands (+4 9070xt) are active
# Example: INVENTORY_CHANNEL_IDS=123456789012345678,987654321098765432
INVENTORY_CHANNEL_IDS=

# Comma-separated user IDs allowed to modify inventory (leave empty = everyone)
AUTHORIZED_USER_IDS=

# Your Discord server ID for instant slash command sync (optional)
# Omit for global sync (takes up to 1 hour)
GUILD_ID=

# ── Database ─────────────────────────────────────────────────────────────
# Path to the SQLite database file (default: partvault.db in project root)
DB_PATH=partvault.db

# ── AI (Phase 2) ─────────────────────────────────────────────────────────
# Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use (default: gemini-2.0-flash — fast and cost-effective)
AI_MODEL=gemini-2.0-flash

# Set to false to disable AI features entirely
AI_ENABLED=true

# ── Pricing (Phase 3) ────────────────────────────────────────────────────
# eBay Developer App ID (Client ID) — register at https://developer.ebay.com/
# Format: YourName-AppName-PRD-xxxxxxxx-xxxxxxxx  (production)
#      or YourName-AppName-SBX-xxxxxxxx-xxxxxxxx  (sandbox)
EBAY_APP_ID=

# How many days between automatic price refreshes (default: 7)
PRICE_REFRESH_DAYS=7

# ── Currency ─────────────────────────────────────────────────────────────
# Default currency for pricing: CAD or USD
DEFAULT_CURRENCY=CAD

# ── Dashboard / GitHub Pages ──────────────────────────────────────────────
# Local HTML file that gets regenerated after inventory changes.
# Configure GitHub Pages to publish from the /docs folder on your main branch.
DASHBOARD_EXPORT_PATH=docs/index.html

# Public GitHub Pages URL returned by /dashboard link
# Example: https://your-github-username.github.io/Dal-Bot/
DASHBOARD_PUBLIC_URL=

# ── Matching ─────────────────────────────────────────────────────────────
# Fuzzy match score threshold (0-100). Higher = stricter.
FUZZY_MATCH_THRESHOLD=70
